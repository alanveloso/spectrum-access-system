# Copy to .env for local overrides (optional for Docker Compose — defaults exist).
# Host/pytest: keep a local sqlite URL. Compose api/worker override DATABASE_URL
# to the in-stack Postgres service regardless of this value.
#
# PRODUCTION SECRETS:
# - Do not put real passwords, broker credentials, or TLS private keys in this file.
# - Inject DATABASE_URL / RABBITMQ / DB_SYNC_* via environment, Docker/K8s secrets,
#   or a sealed secret manager. Keep .env gitignored; use this example as a template only.
# - Certificate private keys live under CERTS_DIR (gitignored ./certs), never in git.

# PostgreSQL (Compose service credentials — placeholders only)
POSTGRES_USER=sas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sas
# Local process default (pytest / python main.py outside Compose):
DATABASE_URL=sqlite:///./sas_mvp.db

# RabbitMQ / Celery (host-side defaults; Compose rebuilds URLs for containers)
RABBITMQ_DEFAULT_USER=sas
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_URL=amqp://sas:change_me@localhost:5672//
CELERY_BROKER_URL=amqp://sas:change_me@localhost:5672//
# CELERY_RESULT_BACKEND=db+postgresql+psycopg2://sas:change_me@localhost:5432/sas

# Spectrum / runtime
SAS_PROFILE=cbrs_winnforum
# SAS_EXECUTION_MODE=production|certification|test
# - production: Celery CPAS; mTLS required (no plain TestClient bypass)
# - certification: inline CPAS; mTLS required; rate limiting forced OFF
# - test: in-process TestClient may omit TLS; never use for deployed UUT
SAS_EXECUTION_MODE=production
SAS_ADMIN_ID=sas_admin_id
FAD_PUBLIC_BASE=https://localhost:9000
SAS_SAS_VERSION=v1.3
HTTP_TIMEOUT_SECONDS=30
MAX_BATCH_SIZE=100

# Operational security (optional)
# SAS_MAX_REQUEST_BODY_BYTES=16777216
# SAS_RATE_LIMIT_ENABLED=false
# SAS_RATE_LIMIT_PER_SECOND=50
# SAS_RATE_LIMIT_BURST=200
# SAS_SSL_OCSP_MODE=disabled
# SAS_FAD_MAX_FILE_BYTES=8388608
# SAS_SSRF_ALLOW_LAB_PRIVATE=false

# API listeners
API_HOST=0.0.0.0
RSA_PORT=9000
ECC_PORT=9001

# Canonical certificate directory for the SAS process.
# Required: server.cert/server.key, server-ecc.cert/server-ecc.key, ca.cert, crl/*.crl.pem
# Rotation: replace PEM/CRL on disk; app-layer CRL is re-read per request.
# TLS handshake context still requires process restart after leaf/CA/CRL replace.
CERTS_HOST_DIR=./certs
CERTS_DIR=/certs

# External federal / marketplace DB basic auth (leave empty until provisioned)
DB_SYNC_USERNAME=
DB_SYNC_PASSWORD=

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
